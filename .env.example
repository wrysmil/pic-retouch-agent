APP_ENV=development
API_PORT=7302

DATABASE_URL=postgresql+asyncpg://retouch:retouch_dev@localhost:7311/retouch
REDIS_URL=redis://localhost:7312

# 默认指向本地 MinIO；换七牛 Kodo 见下方示例
S3_ENDPOINT=http://localhost:7313
# 浏览器访问地址；空则与 S3_ENDPOINT 相同。deploy profile 由 compose 覆盖
S3_PUBLIC_ENDPOINT=
# 七牛原生上传地址；为空则走 S3 put。华南为 https://upload-z2.qiniup.com
S3_UPLOAD_ENDPOINT=
# 公开桶：直接拼固定外链，不再生成会过期的签名 URL
S3_PUBLIC_READ=false
# 签名区域与寻址方式（七牛必须与空间区域一致，如华南 cn-south-1）
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
# 云厂商对象存储通常不允许建桶，换七牛时设为 false
S3_CREATE_BUCKET=true
S3_ACCESS_KEY=retouch
S3_SECRET_KEY=retouch_dev
S3_BUCKET=retouch
S3_URL_TTL=900

# 七牛 Kodo 示例（华南、公开空间）：
# S3_ENDPOINT=https://s3-cn-south-1.qiniucs.com
# S3_UPLOAD_ENDPOINT=https://upload-z2.qiniup.com
# S3_PUBLIC_ENDPOINT=http://你的外链域名
# S3_PUBLIC_READ=true
# S3_REGION=cn-south-1
# S3_CREATE_BUCKET=false
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_BUCKET=你的空间名

# 生产环境必须替换为随机值
JWT_SECRET=dev-only-secret-please-change-in-production
JWT_TTL_HOURS=24

# 厂商 API Key 加密主密钥（Fernet url-safe base64，32 字节）。后台登记连接时用它加密密钥。
SECRET_ENC_KEY=
# 后台可登记的厂商 base URL 白名单（逗号分隔）；开发期本地放行填 allow-localhost
ALLOWED_PROVIDER_HOSTS=api.openai.com,dashscope.aliyuncs.com,api.toookens.com,api.minimax.cn

# AI 模型（规划 / 文生图 / 图编辑）不再走环境变量：
# 请在后台「模型配置」中登记厂商连接与模型并发布运行版本。
# 下面两组只被 scripts/register_toookens.py 与 scripts/register_minimax.py 读取，用于一次性登记。
TOOOKENS_API_KEY=
TOOOKENS_BASE_URL=https://api.toookens.com/v1
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1

# auto 优先 rembg，corner 仅四角抠图
MATTING_PROVIDER=auto
# auto 有 rapidocr 则拆出文字层，none 跳过
OCR_PROVIDER=auto
